# Google Places API — live rating & reviews (optional)
#
# When both variables are set, the star rating and reviews across the whole site
# — the home, About Us, Our Services, Contact and MOT Fareham pages, the rating
# badges and stats, the reviews section and the SEO structured data — pull live
# data from Google and refresh automatically. If they are absent, the site falls
# back to the curated rating and reviews. Keep the API key server-side only —
# never commit real values.
#
# GOOGLE_PLACES_API_KEY: a Google Places API (New) key with "Places API (New)" enabled.
# GOOGLE_PLACES_ID: the Google Place ID for Brookswood Automotive / Fareham MOT Centre.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ID=

# Zapier webhook — form submissions (required for the enquiry forms to reach you)
#
# When this is set, every submission from the callback/contact form and the
# multi-step "Book Now" booking form is forwarded to your Zapier catch hook as a
# JSON payload containing all form fields — Name, Email, Phone, Postcode,
# Service, Registration, Preferred Date, Preferred Time and Message — plus the
# submission type (Full or Partial). The booking form also fires a Partial lead
# to the same hook if a visitor completes the first step and then leaves before
# finishing, so no enquiry is lost. If this variable is absent, forms still work
# for the visitor but nothing is forwarded to Zapier.
#
# Paste the "Catch Hook" URL from your Zapier Zap here (looks like
# https://hooks.zapier.com/hooks/catch/XXXXXXX/XXXXXXX/). Keep it server-side
# only — never commit the real value. Every payload also includes the Google
# Ads click id (GCLID) when the visitor arrived from a Google Ads click.
ZAPIER_WEBHOOK_URL=

# Email notifications — Brevo SMTP (required for enquiries to be emailed to you)
#
# When these are set, every form submission (contact/callback form, the
# multi-step booking form, and the MOT Fareham quote form) is emailed to
# CONTACT_TO_EMAIL via Brevo SMTP, including the GCLID when present. Email always
# sends independently of Zapier, so enquiries still arrive if the webhook fails.
# Keep these server-side only — never commit real values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kangawoo.ai
SMTP_FROM_NAME=Brookswood Automotive
CONTACT_TO_EMAIL=info@brookswoodautomotive.co.uk
